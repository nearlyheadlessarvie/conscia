{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "conscia-api",
    "Environment": "development"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=conscia;Username=conscia;Password=conscia_dev"
  },
  "AWS": {
    "DynamoDB": {
      "ServiceURL": "http://localhost:8000"
    },
    "S3": {
      "ServiceURL": "http://localhost:9000",
      "ForcePathStyle": true,
      "BucketName": "conscia-receipts"
    },
    "SQS": {
      "ServiceURL": "http://localhost:9324"
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2"
  },
  "Tesseract": {
    "BaseUrl": "http://localhost:8080"
  },
  "Auth": {
    "UseMock": true,
    "MockSigningKey": "super-secret-dev-key-at-least-32-chars-long!!",
    "AppJwtIssuer": "conscia-app",
    "AppJwtAudience": "conscia-api"
  }
}
