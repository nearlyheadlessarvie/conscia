{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "AWS": {
    "DynamoDB": {
      "ServiceURL": "http://localhost:8000"
    },
    "S3": {
      "ServiceURL": "http://localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "ForcePathStyle": true,
      "BucketName": "conscia-receipts",
      "EnsureBucketExists": true,
      "UseApiProxyUploads": true
    },
    "SQS": {
      "ServiceURL": "http://localhost:9324"
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2"
  },
  "Tesseract": {
    "BaseUrl": "http://localhost:8080"
  },
  "Auth": {
    "UseMock": true,
    "MockSigningKey": "super-secret-dev-key-at-least-32-chars-long!!"
  },
  "AppCompatibility": {
    "CurrentSupportedAppVersion": "2.0.1+13",
    "PreviousSupportedAppVersion": "1.2.0+11"
  }
}
