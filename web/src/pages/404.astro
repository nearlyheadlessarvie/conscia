---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — Conscia"
  description="This Conscia page could not be found."
>
  <main
    class="min-h-screen"
    style="background: radial-gradient(ellipse at 14% 22%, rgba(233,237,255,0.92) 0%, transparent 48%), radial-gradient(ellipse at 88% 28%, rgba(246,203,104,0.34) 0%, transparent 42%), linear-gradient(170deg, #f7f6ff 0%, #fffdf8 48%, #fff7da 100%);"
  >
    <div class="section-shell flex min-h-screen items-center justify-center py-16">
      <section class="glass-card max-w-2xl px-7 py-9 text-center md:px-12 md:py-12">
        <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-[30px] bg-white shadow-[var(--shadow-soft)]">
          <img src="/images/app_icon.png" alt="" class="h-16 w-16 rounded-[20px]" loading="eager" />
        </div>

        <span class="section-kicker mt-8">Small choices, big freedom</span>

        <h1 class="mt-7 font-heading text-4xl font-extrabold leading-tight text-[var(--ink-strong)] md:text-5xl">
          Page not found.
        </h1>

        <p class="section-copy mx-auto mt-5 max-w-xl">
          This page is not part of Conscia anymore, or the link may have been mistyped.
        </p>

        <a
          href="/"
          class="mt-9 inline-flex items-center justify-center rounded-full bg-[var(--navy)] px-7 py-3 text-sm font-extrabold text-white shadow-[var(--shadow-soft)] transition hover:bg-[var(--ink-strong)]"
        >
          Back to Conscia
        </a>
      </section>
    </div>
  </main>
</Layout>
