---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/icons/Logo.astro';
---

<Layout
  title="Support — Conscia"
  description="Get help with Conscia account access, subscriptions, receipts, family spaces, and privacy requests."
>
  <header class="bg-[#111a46] py-6">
    <div class="mx-auto flex max-w-7xl items-center gap-3 px-6">
      <a href="/" class="flex items-center gap-3 transition hover:opacity-80">
        <Logo size="32" />
        <span class="font-heading text-xl font-bold text-white">Conscia</span>
      </a>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-heading text-4xl font-bold text-[var(--navy)]">Support</h1>
    <p class="mt-2 text-sm text-gray-500">Conscia · getconscia.com</p>

    <div class="mt-10 space-y-10 text-gray-700 leading-relaxed">
      <section>
        <h2 class="font-heading text-xl font-semibold text-gray-900">Contact us</h2>
        <p class="mt-3">
          For help with Conscia, email
          <a href="mailto:hello@getconscia.com" class="font-semibold text-[var(--navy)] underline hover:opacity-80">
            hello@getconscia.com
          </a>.
          We usually respond within 2-3 business days.
        </p>
        <p class="mt-3">
          When possible, include your app version, device model, operating system version, and a short description
          of what happened.
        </p>
      </section>

      <section>
        <h2 class="font-heading text-xl font-semibold text-gray-900">Common support topics</h2>
        <ul class="mt-3 list-disc space-y-2 pl-6">
          <li>Sign in, password reset, and account verification issues.</li>
          <li>Subscription or Premium access questions.</li>
          <li>Receipt scanning, transaction tracking, and budget setup issues.</li>
          <li>Family space invites and shared household planning questions.</li>
          <li>Data export or account deletion questions.</li>
        </ul>
      </section>

      <section>
        <h2 class="font-heading text-xl font-semibold text-gray-900">Privacy and account deletion</h2>
        <p class="mt-3">
          You can delete your account directly in the Conscia app. Step-by-step instructions are available on the
          <a href="/account-deletion" class="font-semibold text-[var(--navy)] underline hover:opacity-80">
            account deletion page
          </a>.
        </p>
        <p class="mt-3">
          For privacy or data requests, email
          <a href="mailto:privacy@getconscia.com" class="font-semibold text-[var(--navy)] underline hover:opacity-80">
            privacy@getconscia.com
          </a>.
        </p>
      </section>

      <section>
        <h2 class="font-heading text-xl font-semibold text-gray-900">Important note</h2>
        <p class="mt-3">
          Conscia is not a financial advisor. Support can help with app usage and account questions, but cannot
          provide financial, investment, legal, or tax advice.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
