---
const eyebrow = 'CONSCIA AUTH';
const title = 'You are signed out';
const description =
  'Your browser session has been cleared. Use the button below to return to the app.';
const schemeBase = 'conscia://auth/logout';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Signed out of Conscia</title>
    <style>
      :root {
        color-scheme: light dark;
        --page-top: #ece2f4;
        --page-bottom: #f6f0fa;
        --card: rgba(252, 247, 255, 0.9);
        --card-border: rgba(57, 29, 74, 0.09);
        --ink: #1f1a24;
        --muted: #625a6b;
        --accent: #6b5dd3;
        --accent-strong: #4e428f;
        --button-ink: #fffaff;
        --shadow: 0 30px 90px rgba(36, 20, 61, 0.16);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --page-top: #161320;
          --page-bottom: #0f0c17;
          --card: rgba(23, 18, 31, 0.9);
          --card-border: rgba(214, 196, 255, 0.09);
          --ink: #f7f0e7;
          --muted: #d1c6df;
          --accent: #b8aeff;
          --accent-strong: #8e84e8;
          --button-ink: #1b142a;
          --shadow: 0 30px 90px rgba(0, 0, 0, 0.36);
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: ui-rounded, "Avenir Next", "Segoe UI", sans-serif;
        color: var(--ink);
        background:
          radial-gradient(circle at top right, rgba(255, 255, 255, 0.28), transparent 32%),
          linear-gradient(180deg, var(--page-top), var(--page-bottom));
      }

      main {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 28px 18px;
      }

      .card {
        width: min(100%, 440px);
        position: relative;
        overflow: hidden;
        padding: 30px 24px 26px;
        border-radius: 28px;
        background: var(--card);
        border: 1px solid var(--card-border);
        box-shadow: var(--shadow);
        backdrop-filter: blur(16px);
      }

      .halo {
        position: absolute;
        inset: -25% -12% auto auto;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(184, 174, 255, 0.3), transparent 72%);
        pointer-events: none;
      }

      .eyebrow {
        margin: 0 0 10px;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        color: var(--accent);
      }

      h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 2.5rem);
        line-height: 0.98;
        letter-spacing: -0.04em;
      }

      p {
        margin: 14px 0 0;
        line-height: 1.55;
        color: var(--muted);
      }

      .actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        padding: 0 18px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 800;
        letter-spacing: 0.01em;
      }

      .button-primary {
        color: var(--button-ink);
        background: linear-gradient(135deg, var(--accent), var(--accent-strong));
      }

      .button-secondary {
        color: var(--ink);
        background: transparent;
        border: 1px solid var(--card-border);
      }

      .note {
        margin-top: 18px;
        font-size: 0.92rem;
      }
    </style>
  </head>
  <body>
    <main>
      <section class="card">
        <div class="halo"></div>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="actions">
          <a class="button button-primary" id="open-app" href={schemeBase}>
            Back to Conscia
          </a>
          <a class="button button-secondary" href="/">
            Stay on the web
          </a>
        </div>
        <p class="note">
          You can sign in again from Conscia whenever you are ready.
        </p>
      </section>
    </main>
    <script is:inline>
      const base = 'conscia://auth/logout';
      const query = window.location.search;
      const hash = window.location.hash;
      const target = `${base}${query}${hash}`;
      const openApp = document.getElementById('open-app');
      if (openApp instanceof HTMLAnchorElement) {
        openApp.href = target;
      }
    </script>
  </body>
</html>
