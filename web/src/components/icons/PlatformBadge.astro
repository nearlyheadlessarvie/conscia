---
interface Props {
  platform: 'ios' | 'android';
  href?: string;
}

const storeUrls = {
  ios: '/under-development?platform=ios',
  android: '/under-development?platform=android',
};

const { platform, href = platform === 'ios' ? storeUrls.ios : storeUrls.android } = Astro.props;

const isIos = platform === 'ios';
const label = isIos ? 'Open on iOS' : 'Open on Android';
---

<a
  href={href}
  aria-label={label}
  class="platform-badge"
>
  <span class="platform-badge-icon">
    {
      isIos ? (
        <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
          <path d="M15.78 12.41c.01 2.28 2 3.04 2.02 3.05-.02.05-.31 1.05-1.01 2.08-.61.89-1.24 1.78-2.24 1.8-.98.02-1.3-.58-2.42-.58-1.13 0-1.48.56-2.4.6-.96.04-1.69-.96-2.31-1.84-1.25-1.82-2.2-5.16-.92-7.37.63-1.1 1.77-1.8 3-1.82.94-.02 1.83.64 2.42.64.58 0 1.67-.79 2.81-.67.48.02 1.82.19 2.68 1.45-.07.04-1.6.94-1.59 2.66Zm-1.79-5.58c.51-.62.86-1.47.76-2.32-.74.03-1.63.49-2.17 1.11-.48.55-.9 1.42-.79 2.25.82.06 1.67-.42 2.2-1.04Z" />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
          <path fill="#00d26a" d="M3.6 2.3 13.4 12 3.6 21.7c-.3-.2-.5-.6-.5-1V3c0-.4.2-.7.5-.7Z"/>
          <path fill="#00b3ff" d="M16.5 15.1 6.1 21.1 14.1 13l2.4 2.1Z"/>
          <path fill="#ffd400" d="M19.8 13.2c1 .6 1 1.7 0 2.3l-3.3 1.9-2.8-2.5 2.8-2.5 3.3 1.9Z"/>
          <path fill="#ff4b5c" d="M6.1 2.9 16.5 8.9 14.1 11 6.1 2.9Z"/>
        </svg>
      )
    }
  </span>
  <span class="platform-badge-copy">
    <span class="platform-badge-kicker">{isIos ? 'Download on the' : 'Get it on'}</span>
    <span class="platform-badge-title">{isIos ? 'App Store' : 'Google Play'}</span>
  </span>
</a>
