---
import Logo from './Logo.astro';

interface Props {
  size?: string;
  class?: string;
  textClass?: string;
}

const { size = '40', class: className = '', textClass = 'text-primary' } = Astro.props;
---

<div class:list={['inline-flex items-center gap-3', className]}>
  <Logo size={size} />
  <span
    class:list={['font-heading font-bold', textClass]}
    style={`font-size: ${parseInt(size) * 0.6}px;`}
  >
    Conscia
  </span>
</div>
