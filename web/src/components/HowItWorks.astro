---
---

<section class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <h2 class="font-heading text-3xl font-bold text-primary md:text-4xl">
        How It Works
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        Three simple steps to smarter spending decisions.
      </p>
    </div>

    <div class="relative mt-16">
      <!-- Connecting line (hidden on mobile) -->
      <div class="absolute left-0 right-0 top-10 hidden h-0.5 bg-gradient-to-r from-primary/10 via-primary/20 to-primary/10 md:block"></div>

      <div class="grid gap-12 md:grid-cols-3 md:gap-8">
        <!-- Step 1 -->
        <div class="flex flex-col items-center text-center">
          <div class="relative z-10 flex h-20 w-20 items-center justify-center rounded-full bg-primary shadow-lg">
            <span class="font-heading text-2xl font-bold text-white">1</span>
          </div>
          <div class="mt-8">
            <!-- Thought bubble icon -->
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/5">
              <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/>
              </svg>
            </div>
            <h3 class="font-heading text-lg font-semibold text-gray-900">Ask Before You Buy</h3>
            <p class="mt-2 text-gray-600">
              Describe what you want to buy. Your AI conscience weighs in with both sides.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flex flex-col items-center text-center">
          <div class="relative z-10 flex h-20 w-20 items-center justify-center rounded-full bg-primary shadow-lg">
            <span class="font-heading text-2xl font-bold text-white">2</span>
          </div>
          <div class="mt-8">
            <!-- Chart icon -->
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/5">
              <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
              </svg>
            </div>
            <h3 class="font-heading text-lg font-semibold text-gray-900">Track & Reflect</h3>
            <p class="mt-2 text-gray-600">
              Log transactions. After 24 hours, reflect — was it worth it?
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flex flex-col items-center text-center">
          <div class="relative z-10 flex h-20 w-20 items-center justify-center rounded-full bg-primary shadow-lg">
            <span class="font-heading text-2xl font-bold text-white">3</span>
          </div>
          <div class="mt-8">
            <!-- Trending up icon -->
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/5">
              <svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/>
              </svg>
            </div>
            <h3 class="font-heading text-lg font-semibold text-gray-900">Build Better Habits</h3>
            <p class="mt-2 text-gray-600">
              Watch your spending patterns improve over time with data-driven insights.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
