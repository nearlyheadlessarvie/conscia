---
import { getMascotFrame } from '../../utils/mascotFrames.js';

const {
  kind,
  pose,
  class: className = '',
  alt = '',
  scale = 1,
} = Astro.props;

const frame = getMascotFrame(kind, pose);
const scaledWidth = frame.width * scale;
const scaledHeight = frame.height * scale;
const scaledX = frame.x * scale;
const scaledY = frame.y * scale;
const scaledSheetWidth = frame.sheetWidth * scale;
const scaledSheetHeight = frame.sheetHeight * scale;
---

<div
  class={`mascot-frame ${className}`}
  role="img"
  aria-label={alt}
  style={`width:${scaledWidth}px; height:${scaledHeight}px;`}
>
  <div
    class="mascot-sprite"
    style={`background-image:url(${frame.imagePath}); background-position:-${scaledX}px -${scaledY}px; background-size:${scaledSheetWidth}px ${scaledSheetHeight}px; width:${scaledWidth}px; height:${scaledHeight}px;`}
  ></div>
</div>
