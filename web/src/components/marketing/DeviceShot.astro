---
interface Props {
  src: string;
  alt: string;
  widthClass?: string;
  class?: string;
  eager?: boolean;
  framed?: boolean;
}

const {
  src,
  alt,
  widthClass = 'w-[220px]',
  class: className = '',
  eager = false,
  framed = true,
} = Astro.props;
---

<div class:list={['device-shot', widthClass, className]}>
  <div class:list={['device-shot-frame', !framed && 'device-shot-frame-raw']}>
    <img
      src={src}
      alt={alt}
      class="device-shot-image"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
</div>
