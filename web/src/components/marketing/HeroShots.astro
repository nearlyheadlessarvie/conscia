---
import DeviceShot from './DeviceShot.astro';
---

<div class="hero-shots" aria-label="Conscia app preview screens">
  <div class="hero-shots-panel hero-shots-panel-left"></div>
  <div class="hero-shots-panel hero-shots-panel-right"></div>

  <DeviceShot
    src="/images/marketing/budget.png"
    alt="Conscia budgets screen"
    widthClass="w-[204px] md:w-[250px]"
    class="hero-shot hero-shot-left"
    eager={true}
    framed={false}
  />
  <DeviceShot
    src="/images/marketing/journey.png"
    alt="Conscia journey screen"
    widthClass="w-[236px] md:w-[286px]"
    class="hero-shot hero-shot-center"
    eager={true}
    framed={false}
  />
  <DeviceShot
    src="/images/marketing/purchase-assistant.png"
    alt="Conscia purchase assistant screen"
    widthClass="w-[204px] md:w-[250px]"
    class="hero-shot hero-shot-right"
    eager={true}
    framed={false}
  />
</div>
