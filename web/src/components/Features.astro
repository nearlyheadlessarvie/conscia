---
---

<section class="bg-[#FAFAFA] py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <h2 class="font-heading text-3xl font-bold text-primary md:text-4xl">
        Why Conscia?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        A financial assistant that actually understands the psychology of spending.
      </p>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-3">
      <!-- Card 1: AI Pre-Purchase Advisor -->
      <div class="group rounded-card bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
        <!-- Devil/Angel icon -->
        <div class="relative mb-6 h-14 w-14">
          <div class="absolute left-0 top-0 h-10 w-10 rounded-full bg-devil/15 transition group-hover:bg-devil/25"></div>
          <div class="absolute bottom-0 right-0 h-10 w-10 rounded-full bg-angel/15 transition group-hover:bg-angel/25"></div>
        </div>
        <h3 class="font-heading text-xl font-semibold text-gray-900">
          AI Pre-Purchase Advisor
        </h3>
        <p class="mt-3 leading-relaxed text-gray-600">
          Meet Impulse and Reason — your personal devil and angel. They'll debate whether you really need that purchase.
        </p>
        <div class="mt-4 flex gap-2">
          <span class="inline-block h-1 w-8 rounded-full bg-devil/40"></span>
          <span class="inline-block h-1 w-8 rounded-full bg-angel/40"></span>
        </div>
      </div>

      <!-- Card 2: Smart Budget Tracking -->
      <div class="group rounded-card bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
        <!-- Bar chart icon -->
        <div class="mb-6 flex h-14 w-14 items-end gap-1 rounded-xl bg-income/10 p-3">
          <div class="w-2 rounded-sm bg-income/60 transition group-hover:bg-income" style="height: 40%"></div>
          <div class="w-2 rounded-sm bg-secondary/60 transition group-hover:bg-secondary" style="height: 70%"></div>
          <div class="w-2 rounded-sm bg-income/60 transition group-hover:bg-income" style="height: 100%"></div>
          <div class="w-2 rounded-sm bg-secondary/60 transition group-hover:bg-secondary" style="height: 55%"></div>
        </div>
        <h3 class="font-heading text-xl font-semibold text-gray-900">
          Smart Budget Tracking
        </h3>
        <p class="mt-3 leading-relaxed text-gray-600">
          Set budgets by category. Track spending in real-time. Get warnings before you overspend.
        </p>
        <div class="mt-4 flex gap-2">
          <span class="inline-block h-1 w-8 rounded-full bg-income/40"></span>
          <span class="inline-block h-1 w-8 rounded-full bg-secondary/40"></span>
        </div>
      </div>

      <!-- Card 3: Receipt Scanner -->
      <div class="group relative rounded-card bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
        <!-- Premium badge -->
        <span class="absolute right-6 top-6 rounded-pill bg-secondary/15 px-3 py-1 text-xs font-semibold text-secondary-dark">
          Premium
        </span>
        <!-- Camera icon -->
        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-secondary/10">
          <svg class="h-7 w-7 text-secondary transition group-hover:text-secondary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"/>
          </svg>
        </div>
        <h3 class="font-heading text-xl font-semibold text-gray-900">
          Receipt Scanner
        </h3>
        <p class="mt-3 leading-relaxed text-gray-600">
          Snap a photo of any receipt. AI extracts the details and logs the transaction automatically.
        </p>
        <div class="mt-4 flex gap-2">
          <span class="inline-block h-1 w-8 rounded-full bg-secondary/40"></span>
          <span class="inline-block h-1 w-8 rounded-full bg-primary/20"></span>
        </div>
      </div>
    </div>
  </div>
</section>
