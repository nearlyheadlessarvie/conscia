---
import LogoWithText from './icons/LogoWithText.astro';
import PlatformBadge from './icons/PlatformBadge.astro';
import HeroPhone from './marketing/HeroPhone.astro';
import { heroContent } from '../data/marketingChapters.js';

const navLinks = [
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Transactions', href: '#transactions-and-filters' },
  { label: 'Reflection', href: '#reflection-and-purchase-assistant' },
  { label: 'Insights', href: '#insights-and-merchant-signals' },
  { label: 'Household', href: '#shared-household-and-settings' },
];
---

<section
  class="relative pt-6"
  style="background: radial-gradient(ellipse at 10% 30%, rgba(246,203,104,0.22) 0%, transparent 50%), radial-gradient(ellipse at 90% 70%, rgba(123,208,215,0.18) 0%, transparent 45%), linear-gradient(170deg, #f7f2ea 0%, #fffdf7 45%, #f0f5ff 100%);"
>
  <!-- sticky nav -->
  <div class="hero-nav-shell fixed inset-x-0 top-4 z-50">
    <div class="section-shell">
      <nav class="hero-nav glass-card flex items-center justify-between px-5 py-4 md:px-7">
        <LogoWithText size="38" />
        <ul class="hidden items-center gap-6 md:flex">
          {navLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                data-section={href.slice(1)}
                class="nav-link relative text-sm font-medium text-[var(--ink-muted)] transition-colors hover:text-[var(--navy)]"
              >
                {label}
                <span class="nav-link-bar absolute -bottom-1 left-0 h-[2px] w-full origin-left scale-x-0 rounded-full bg-[var(--gold)] transition-transform duration-300"></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <!-- hero body -->
  <div class="section-shell relative pb-16 pt-32 md:pb-20 md:pt-40">
    <div class="grid items-center gap-12 lg:grid-cols-2">

      <!-- copy -->
      <div class="relative z-10">
        <span class="section-kicker">{heroContent.kicker}</span>

        <h1 class="mt-7 max-w-2xl font-heading text-5xl font-extrabold leading-[1.04] tracking-[-0.04em] text-[var(--ink-strong)] md:text-6xl lg:text-7xl">
          {heroContent.title}
        </h1>

        <p class="section-copy mt-6 max-w-xl">{heroContent.body}</p>

        <div class="mt-10 flex flex-wrap gap-3">
          <PlatformBadge platform="ios" />
          <PlatformBadge platform="android" />
        </div>
      </div>

      <!-- phone -->
      <div class="flex justify-center lg:justify-end">
        <HeroPhone />
      </div>

    </div>
  </div>
</section>

<script>
  // Scrollspy
  const links = document.querySelectorAll<HTMLAnchorElement>('a[data-section]');
  const sectionIds = Array.from(links).map(a => a.dataset.section!);

  const setActive = (id: string | null) => {
    links.forEach(a => {
      const bar = a.querySelector('.nav-link-bar') as HTMLElement | null;
      const isActive = a.dataset.section === id;
      a.classList.toggle('text-[var(--navy)]', isActive);
      a.classList.toggle('text-[var(--ink-muted)]', !isActive);
      if (bar) bar.style.transform = isActive ? 'scaleX(1)' : 'scaleX(0)';
    });
  };

  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: '-30% 0px -60% 0px' }
  );

  sectionIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // Nav dock + top-of-page threshold
  const navShell = document.querySelector('.hero-nav-shell');
  const dockAtTop = () => {
    if (!navShell) return;
    navShell.classList.toggle('is-docked', window.scrollY > 50);
  };
  dockAtTop();
  window.addEventListener('scroll', () => {
    dockAtTop();
    if (window.scrollY < 80) setActive(null);
  }, { passive: true });
</script>
