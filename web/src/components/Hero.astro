---
import Logo from './icons/Logo.astro';
import LogoWithText from './icons/LogoWithText.astro';
---

<section class="relative overflow-hidden bg-white">
  <!-- Subtle radial gradient background -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(26,35,126,0.03)_0%,_transparent_60%)]"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-24 lg:py-32">
    <!-- Logo mark at top -->
    <div class="mb-8 flex justify-center lg:justify-start">
      <LogoWithText size="48" />
    </div>

    <div class="flex flex-col items-center gap-12 lg:flex-row lg:gap-16">
      <!-- App Icon / Visual -->
      <div class="flex shrink-0 items-center justify-center lg:order-2">
        <Logo size="240" class="drop-shadow-2xl" />
      </div>

      <!-- Text content -->
      <div class="flex-1 text-center lg:text-left">
        <h1 class="font-heading text-4xl font-bold leading-tight text-primary md:text-5xl lg:text-6xl">
          Your Financial<br />Conscience
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg text-gray-600 md:text-xl lg:mx-0">
          Before you buy, ask yourself — or let two AI advisors argue it out for you.
        </p>

        <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row lg:justify-start">
          <a
            href="#"
            class="inline-flex items-center gap-2 rounded-pill bg-primary px-8 py-4 font-body text-sm font-semibold text-white shadow-lg transition hover:bg-primary-dark hover:shadow-xl"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/>
            </svg>
            Download on App Store
          </a>
          <a
            href="#"
            class="inline-flex items-center gap-2 rounded-pill border-2 border-primary px-8 py-4 font-body text-sm font-semibold text-primary transition hover:bg-primary hover:text-white"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 8.99l-2.3 2.3-8.636-8.632z"/>
            </svg>
            Get on Google Play
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
