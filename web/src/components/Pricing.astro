            </svg>
            <span class="text-gray-400">Multi-currency</span>
          </li>
        </ul>

        <a
          href="#"
          class="block rounded-pill border-2 border-primary py-3 text-center font-body text-sm font-semibold text-primary transition hover:bg-primary hover:text-white"
        >
          Download Free
        </a>
      </div>

      <!-- Premium Plan -->
      <div class="relative flex flex-col rounded-card border-2 border-secondary bg-white p-8 shadow-lg">
        <!-- Popular badge -->
        <div class="absolute -top-4 left-1/2 -translate-x-1/2">
          <span class="inline-flex items-center gap-1 rounded-pill bg-secondary px-4 py-1.5 text-xs font-bold text-white shadow-md">
            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
