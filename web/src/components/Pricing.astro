        <div class="mb-6">
          <h3 class="font-heading text-2xl font-semibold text-gray-900">Premium</h3>
          <div class="mt-4">
            <span class="font-heading text-4xl font-bold text-gray-900">$4.99</span>
            <span class="ml-2 text-gray-500">/ month</span>
          </div>
        </div>

        <ul class="mb-8 flex-1 space-y-4">
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-income" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
