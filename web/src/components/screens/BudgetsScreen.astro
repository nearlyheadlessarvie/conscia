---
---

<div class="screen-transactions p-4 pt-8" style="min-height: 420px;">
  <p class="text-[11px] font-extrabold text-[var(--navy)] text-center mb-4">Budgets</p>

  <div class="mb-4 rounded-[18px] border border-[rgba(31,47,115,0.08)] bg-white/92 p-4 shadow-[var(--shadow-soft)]">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[7px] font-bold uppercase tracking-[1.4px] text-[var(--navy)]">Budget pace</p>
        <p class="mt-1 font-heading text-[19px] font-extrabold text-[var(--navy)]">₱19,500.00</p>
        <p class="mt-2 text-[8px] leading-4 text-[var(--ink-muted)]">Dining is currently carrying your strongest budget signal.</p>
      </div>
      <div class="relative mt-1 h-24 w-24 rounded-full border-[8px] border-pink-500/85 border-t-blue-500 border-l-green-500 border-r-pink-500">
        <div class="absolute inset-3 flex items-center justify-center rounded-full bg-white text-[10px] font-extrabold text-[var(--navy)]">62%</div>
      </div>
    </div>

    <div class="mt-3 rounded-full bg-[rgba(216,219,238,0.88)] p-1 text-[8px] font-extrabold text-[var(--navy)]">
      <div class="grid grid-cols-2">
        <span class="rounded-full bg-white px-3 py-2 text-center">Personal</span>
        <span class="px-3 py-2 text-center text-[var(--ink-muted)]">Family</span>
      </div>
    </div>

    <div class="mt-3 flex flex-wrap gap-1.5 text-[7px] font-semibold text-[var(--navy)]">
      <span class="rounded-full bg-white px-2.5 py-1.5">Bills 43%</span>
      <span class="rounded-full bg-white px-2.5 py-1.5">Dining 31%</span>
      <span class="rounded-full bg-white px-2.5 py-1.5">Shopping 26%</span>
    </div>
  </div>

  <p class="text-[8px] font-bold uppercase tracking-[1.4px] text-[var(--navy)] mb-2">Category system</p>
  <div class="mb-2 rounded-[12px] border border-[rgba(31,47,115,0.08)] bg-white/92 p-3 shadow-[var(--shadow-soft)]">
    <p class="text-[9px] font-extrabold text-[var(--navy)]">Keep your money language tidy</p>
    <p class="mt-1 text-[7px] text-[var(--ink-muted)]">Categories connect transactions, budgets, and insights without making you rename things twice.</p>
  </div>

  <div class="flex flex-wrap gap-1.5">
    <span class="rounded-full bg-white/92 px-2.5 py-1.5 text-[8px] font-semibold text-[var(--navy)]">Bills</span>
    <span class="rounded-full bg-white/92 px-2.5 py-1.5 text-[8px] font-semibold text-[var(--navy)]">Dining</span>
    <span class="rounded-full bg-white/92 px-2.5 py-1.5 text-[8px] font-semibold text-[var(--navy)]">Education</span>
    <span class="rounded-full bg-white/92 px-2.5 py-1.5 text-[8px] font-semibold text-[var(--navy)]">Gift</span>
  </div>
</div>
