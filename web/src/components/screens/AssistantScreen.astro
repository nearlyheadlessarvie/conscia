---

<div class="screen-reflect p-4 pt-8" style="min-height: 420px;">
  <p class="text-[11px] font-extrabold text-[var(--navy)] text-center mb-4">Purchase Assistant</p>

  <div class="mb-4 rounded-[18px] border border-[rgba(31,47,115,0.08)] bg-white/92 p-4 text-center shadow-[var(--shadow-soft)]">
    <div class="mx-auto mb-3 h-16 w-16 rounded-full bg-[radial-gradient(circle,_rgba(246,203,104,0.55),_rgba(233,237,255,0.35)_60%,_transparent_75%)]"></div>
    <p class="font-heading text-[18px] font-extrabold text-[var(--navy)]">Let&apos;s think this through</p>
    <p class="mt-1 text-[8px] text-[var(--ink-muted)]">Conscia helps you pause before you spend.</p>
  </div>

  <p class="text-[8px] font-bold uppercase tracking-[1.4px] text-[var(--navy)] mb-2">Decision details</p>
  <div class="mb-2 rounded-[12px] border border-[var(--navy)] bg-white/94 px-3 py-2.5 text-[8px] font-semibold text-[var(--ink-muted)]">What are you thinking of buying?</div>
  <div class="mb-3 rounded-[12px] border border-[rgba(31,47,115,0.08)] bg-[rgba(233,237,255,0.55)] px-3 py-3 text-[9px] font-extrabold text-red-400">PHP <span class="float-right text-red-200">0.00</span></div>

  <p class="text-[8px] font-bold uppercase tracking-[1.4px] text-[var(--navy)] mb-2">Category</p>
  <div class="mb-3 flex flex-wrap gap-1.5">
    <span class="rounded-full bg-white/88 px-2.5 py-1.5 text-[8px] font-semibold text-[var(--navy)]">Health</span>
    <span class="rounded-full bg-white/88 px-2.5 py-1.5 text-[8px] font-semibold text-[var(--navy)]">Travel</span>
    <span class="rounded-full bg-white/88 px-2.5 py-1.5 text-[8px] font-semibold text-[var(--navy)]">Dining</span>
    <span class="rounded-full bg-white/88 px-2.5 py-1.5 text-[8px] font-semibold text-[var(--navy)]">Coffee</span>
  </div>

  <p class="text-[8px] font-bold uppercase tracking-[1.4px] text-[var(--navy)] mb-2">Classify</p>
  <div class="mb-4 rounded-full bg-[rgba(216,219,238,0.85)] p-1 text-[8px] font-extrabold text-[var(--navy)]">
    <div class="grid grid-cols-2">
      <span class="rounded-full bg-white px-3 py-2 text-center">Personal</span>
      <span class="px-3 py-2 text-center text-[var(--ink-muted)]">Family</span>
    </div>
  </div>

  <div class="rounded-full bg-[rgba(216,219,238,0.85)] px-3 py-3 text-center text-[9px] font-extrabold text-[var(--ink-muted)]">Ask Conscia ✦</div>
</div>
