<div class="screen-insights p-4 pt-8" style="min-height: 420px;">
  <p class="text-[11px] font-extrabold text-[var(--navy)] text-center mb-4">Shared Conscia</p>

  <div class="mb-4 rounded-[18px] border border-[rgba(31,47,115,0.08)] bg-white/92 p-4 shadow-[var(--shadow-soft)]">
    <p class="text-[7px] font-bold uppercase tracking-[1.4px] text-[var(--navy)]">Shared household</p>
    <p class="mt-1 font-heading text-[18px] font-extrabold text-[var(--navy)]">Santos Household</p>
    <p class="mt-2 text-[8px] leading-4 text-[var(--ink-muted)]">Plan together without exposing everything personal.</p>

    <div class="mt-3 flex gap-1.5 text-[7px] font-semibold text-[var(--navy)]">
      <span class="rounded-full bg-[rgba(233,237,255,0.78)] px-2.5 py-1.5">Owner</span>
      <span class="rounded-full bg-[rgba(233,237,255,0.78)] px-2.5 py-1.5">PHP</span>
      <span class="rounded-full bg-[rgba(233,237,255,0.78)] px-2.5 py-1.5">3 members</span>
    </div>
  </div>

  <div class="mb-3 rounded-[14px] border border-[rgba(31,47,115,0.08)] bg-white/92 p-3 shadow-[var(--shadow-soft)]">
    <p class="text-[9px] font-extrabold text-[var(--navy)]">Members</p>
    <div class="mt-2 space-y-2 text-[8px] text-[var(--ink-muted)]">
      <div class="flex items-center justify-between"><span>story-demo@example.com</span><span class="text-[var(--navy)]">Owner</span></div>
      <div class="flex items-center justify-between"><span>story-spouse@example.com</span><span>Contributor</span></div>
      <div class="flex items-center justify-between"><span>story-viewer@example.com</span><span>Viewer</span></div>
    </div>
  </div>

  <div class="rounded-[14px] border border-[rgba(31,47,115,0.08)] bg-white/92 p-3 shadow-[var(--shadow-soft)]">
    <p class="text-[9px] font-extrabold text-[var(--navy)]">Settings hub</p>
    <div class="mt-2 space-y-2 text-[8px] text-[var(--ink-muted)]">
      <div class="flex items-center justify-between"><span>AI personality</span><span class="text-[var(--navy)]">Balanced</span></div>
      <div class="flex items-center justify-between"><span>Conscia Premium</span><span class="text-[var(--navy)]">Active</span></div>
      <div class="flex items-center justify-between"><span>Default currency</span><span>PHP</span></div>
    </div>
  </div>
</div>
