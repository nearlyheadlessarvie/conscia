---
const roadmap = [
  {
    phase: 'Now shipping',
    labelClass: 'chip-angel',
    title: 'A redesigned core experience',
    items: [
      'Guided onboarding with suggested budgets',
      'Pre-purchase assistant with adjustable personality intensity',
      'Fast transaction entry with smart suggestions and recent categories',
      'Reflection sheets, regret capture, and budget-aware dashboard alerts',
    ],
  },
  {
    phase: 'Next',
    labelClass: 'chip-gold',
    title: 'A richer memory layer',
    items: [
      'Dedicated regret-memory alert system with better prioritization',
      'Weekly digest summaries that connect spending with emotion',
      'Voice-first entry that feels native across assistant and transaction flows',
      'Smarter nearby merchant and category suggestions',
    ],
  },
  {
    phase: 'Later',
    labelClass: 'chip-devil',
    title: 'Deeper shared planning and insight surfaces',
    items: [
      'More expressive insight tabs and merchant pattern breakdowns',
      'Collaborative household budget flows',
      'Longer-term goal framing and milestone nudges',
      'Marketing and product surfaces that keep evolving together',
    ],
  },
];
---

<section id="roadmap" class="py-24 md:py-32">
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <span class="section-kicker">Roadmap</span>
      <h2 class="section-heading mt-6">
        Built in phases, but designed to feel like one conscience all the way through.
      </h2>
      <p class="section-copy mt-6">
        The next releases deepen the same idea instead of branching into unrelated features: less generic
        budgeting, more memory, more context, and better guidance.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {roadmap.map((phase) => (
        <article class="feature-panel flex h-full flex-col">
          <span class:list={[phase.labelClass]}>{phase.phase}</span>
          <h3 class="mt-5 text-2xl font-extrabold tracking-tight text-[var(--ink-strong)]">
            {phase.title}
          </h3>

          <ul class="mt-6 space-y-4 text-sm leading-7 text-[var(--ink-muted)]">
            {phase.items.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-2.5 w-2.5 rounded-full bg-[rgba(23,36,79,0.2)]"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
