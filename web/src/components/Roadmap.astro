---
---

<section class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center">
      <h2 class="font-heading text-3xl font-bold text-primary md:text-4xl">
        What's Coming Next
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        We're just getting started. Here's what's on the roadmap.
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-4xl">
      <!-- Timeline -->
      <div class="relative space-y-12 border-l-2 border-primary/15 pl-8 md:pl-12">

        <!-- Phase: Now -->
        <div class="relative">
          <div class="absolute -left-[calc(2rem+5px)] flex h-10 w-10 items-center justify-center rounded-full bg-income text-white shadow-md md:-left-[calc(3rem+5px)]">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <div>
            <span class="inline-flex items-center gap-2 rounded-pill bg-income/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-income">
              Live Now
            </span>
            <h3 class="mt-3 font-heading text-xl font-semibold text-gray-900">Core Experience</h3>
            <ul class="mt-3 space-y-2 text-gray-600">
              <li class="flex items-start gap-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-income" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Manual transaction tracking with categories
              </li>
              <li class="flex items-start gap-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-income" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                AI pre-purchase advisor (Impulse & Reason)
              </li>
              <li class="flex items-start gap-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-income" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Budget tracking with spending alerts
              </li>
              <li class="flex items-start gap-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-income" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                24-hour purchase reflection system
              </li>
              <li class="flex items-start gap-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-income" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Receipt scanning with AI extraction (Premium)
              </li>
              <li class="flex items-start gap-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-income" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Multi-currency support (Premium)
              </li>
            </ul>
          </div>
        </div>

        <!-- Phase: Q3 2026 -->
        <div class="relative">
          <div class="absolute -left-[calc(2rem+5px)] flex h-10 w-10 items-center justify-center rounded-full bg-secondary text-white shadow-md md:-left-[calc(3rem+5px)]">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <span class="inline-flex items-center gap-2 rounded-pill bg-secondary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-secondary-dark">
              Q3 2026
            </span>
            <h3 class="mt-3 font-heading text-xl font-semibold text-gray-900">Smarter Insights</h3>
            <ul class="mt-3 space-y-2 text-gray-600">
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-secondary/50"></span>
                Spending trends & monthly reports with visual breakdowns
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-secondary/50"></span>
                Recurring transaction detection & reminders
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-secondary/50"></span>
                Custom budget period selection (weekly, bi-weekly, monthly)
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-secondary/50"></span>
                Export data as CSV / PDF
              </li>
            </ul>
          </div>
        </div>

        <!-- Phase: Q4 2026 -->
        <div class="relative">
          <div class="absolute -left-[calc(2rem+5px)] flex h-10 w-10 items-center justify-center rounded-full bg-primary text-white shadow-md md:-left-[calc(3rem+5px)]">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/>
            </svg>
          </div>
          <div>
            <span class="inline-flex items-center gap-2 rounded-pill bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary">
              Q4 2026
            </span>
            <h3 class="mt-3 font-heading text-xl font-semibold text-gray-900">AI Evolution</h3>
            <ul class="mt-3 space-y-2 text-gray-600">
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-primary/40"></span>
                AI personality memory — Impulse & Reason learn your spending patterns
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-primary/40"></span>
                Proactive spending alerts based on budget velocity
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-primary/40"></span>
                Savings goals with AI-powered milestone tracking
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-primary/40"></span>
                Shared budgets for couples and families
              </li>
            </ul>
          </div>
        </div>

        <!-- Phase: 2027 -->
        <div class="relative">
          <div class="absolute -left-[calc(2rem+5px)] flex h-10 w-10 items-center justify-center rounded-full bg-gray-200 text-gray-500 shadow-md md:-left-[calc(3rem+5px)]">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
            </svg>
          </div>
          <div>
            <span class="inline-flex items-center gap-2 rounded-pill bg-gray-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-gray-500">
              2027 & Beyond
            </span>
            <h3 class="mt-3 font-heading text-xl font-semibold text-gray-900">Future Vision</h3>
            <ul class="mt-3 space-y-2 text-gray-600">
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-gray-300"></span>
                Bank account linking (read-only) for automatic transaction import
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-gray-300"></span>
                Subscription tracker — detect and manage recurring charges
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-gray-300"></span>
                Apple Watch & Wear OS companion app
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-gray-300"></span>
                Widgets for iOS & Android home screens
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-gray-300"></span>
                Community challenges — save together with friends
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>

    <!-- CTA -->
    <div class="mt-20 text-center">
      <p class="text-lg text-gray-600">Have a feature idea?</p>
      <a href="mailto:feedback@getconscia.com" class="mt-3 inline-flex items-center gap-2 font-heading text-lg font-semibold text-primary transition hover:text-primary-dark">
        Let us know
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
