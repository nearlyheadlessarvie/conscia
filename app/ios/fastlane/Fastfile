default_platform(:ios)

platform :ios do
  desc "Build and upload the Conscia iOS release to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_PRIVATE_KEY"),
      duration: 1200,
      in_house: false
    )

    keychain_name = "app-signing.keychain-db"
    keychain_password = ENV.fetch("KEYCHAIN_PASSWORD")

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 21_600,
      lock_when_sleeps: false
    )

    match(
      type: "appstore",
      readonly: true,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
      app_identifier: [ENV.fetch("IOS_BUNDLE_ID")],
      api_key: api_key,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      archive_path: "../build/ios/archive/Runner.xcarchive",
      output_directory: "../build/ios/ipa",
      output_name: "Runner.ipa",
      export_options: {
        compileBitcode: false,
        signingStyle: "manual",
        stripSwiftSymbols: true
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/ios/ipa/Runner.ipa",
      skip_waiting_for_build_processing: false
    )
  end
end
